{{- printf `<?xml version="1.0" encoding="utf-8" standalone="yes"?>` | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Params.description | default .Site.Title }}</description>
    <generator>Hugo {{ hugo.Version }}</generator>
    <language>{{ .Site.Language.Locale | default "en" }}</language>
    {{ $authorName := "" }}
    {{ $authorEmail := "" }}
    {{ with .Site.Params.author }}
      {{ if reflect.IsMap . }}
        {{ $authorName = .name | default "" }}
        {{ $authorEmail = .email | default "" }}
      {{ else }}
        {{ $authorName = . }}
      {{ end }}
    {{ end }}
    {{ with $authorName }}
      <managingEditor>{{ . }}{{ with $authorEmail }} ({{ . }}){{ end }}</managingEditor>
      <webMaster>{{ . }}{{ with $authorEmail }} ({{ . }}){{ end }}</webMaster>
    {{ end }}
    {{ with .Site.Params.copyright }}
      <copyright>{{ . }}</copyright>
    {{ end }}
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>
    {{ $rssLimit := .Site.Config.Services.RSS.Limit }}
    {{ $pages := where .Site.RegularPages "Type" "in" .Site.Params.mainSections }}
    {{ if gt $rssLimit 0 }}
      {{ $pages = first $rssLimit $pages }}
    {{ end }}
    {{ range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{ with $authorName }}
        <author>{{ . }}{{ with $authorEmail }} ({{ . }}){{ end }}</author>
      {{ end }}
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Summary | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
