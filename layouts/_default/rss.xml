{{- printf `<?xml version="1.0" encoding="utf-8" standalone="yes"?>` | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Params.description | default .Site.Title }}</description>
    <generator>Hugo {{ hugo.Version }}</generator>
    <language>{{ .Site.Language.Locale | default "en" }}</language>
    {{ with .Site.Params.author.name }}
      <managingEditor>{{ . }}{{ with $.Site.Params.author.email }} ({{ . }}){{ end }}</managingEditor>
      <webMaster>{{ . }}{{ with $.Site.Params.author.email }} ({{ . }}){{ end }}</webMaster>
    {{ else }}
      {{ with .Site.Params.author }}
        <managingEditor>{{ . }}</managingEditor>
        <webMaster>{{ . }}</webMaster>
      {{ end }}
    {{ end }}
    {{ with .Site.Params.copyright }}
      <copyright>{{ . }}</copyright>
    {{ end }}
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>
    {{ $rssLimit := .Site.Config.Services.RSS.Limit }}
    {{ $pages := where .Site.RegularPages "Type" "in" .Site.Params.mainSections }}
    {{ if gt $rssLimit 0 }}
      {{ $pages = first $rssLimit $pages }}
    {{ end }}
    {{ range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{ with .Site.Params.author.name }}
        <author>{{ . }}{{ with $.Site.Params.author.email }} ({{ . }}){{ end }}</author>
      {{ else }}
        {{ with .Site.Params.author }}
          <author>{{ . }}</author>
        {{ end }}
      {{ end }}
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Summary | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
